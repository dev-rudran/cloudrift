{
  "format_version": "1.2",
  "terraform_version": "1.9.8",
  "planned_values": {
    "root_module": {
      "resources": [
        {
          "address": "aws_s3_bucket.logs",
          "mode": "managed",
          "type": "aws_s3_bucket",
          "name": "logs",
          "values": {
            "bucket": "acme-audit-logs",
            "acl": "private",
            "server_side_encryption_configuration": [
              {
                "rule": [
                  {
                    "apply_server_side_encryption_by_default": [
                      {
                        "sse_algorithm": "AES256"
                      }
                    ]
                  }
                ]
              }
            ],
            "versioning": [
              {
                "enabled": true
              }
            ],
            "logging": [
              {
                "target_bucket": "acme-audit-logs",
                "target_prefix": "logs/"
              }
            ]
          }
        },
        {
          "address": "aws_s3_bucket_policy.logs",
          "mode": "managed",
          "type": "aws_s3_bucket_policy",
          "name": "logs",
          "values": {
            "bucket": "acme-audit-logs",
            "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Principal\": {\"AWS\": \"arn:aws:iam::111122223333:role/audit\"}, \"Action\": \"s3:GetObject\", \"Resource\": \"arn:aws:s3:::acme-audit-logs/*\"}]}"
          }
        },
        {
          "address": "aws_security_group.web",
          "mode": "managed",
          "type": "aws_security_group",
          "name": "web",
          "values": {
            "name": "web-private",
            "id": "sg-web",
            "description": "web tier",
            "ingress": [
              {
                "from_port": 22,
                "to_port": 22,
                "protocol": "tcp",
                "cidr_blocks": [
                  "10.0.0.0/8"
                ],
                "ipv6_cidr_blocks": []
              }
            ]
          }
        },
        {
          "address": "aws_instance.app",
          "mode": "managed",
          "type": "aws_instance",
          "name": "app",
          "values": {
            "ami": "ami-0123456789abcdef0",
            "instance_type": "t3.micro",
            "associate_public_ip_address": false,
            "vpc_security_group_ids": [
              "sg-web"
            ]
          }
        },
        {
          "address": "aws_iam_policy.readonly",
          "mode": "managed",
          "type": "aws_iam_policy",
          "name": "readonly",
          "values": {
            "name": "readonly",
            "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Action\": [\"s3:GetObject\"], \"Resource\": \"arn:aws:s3:::acme-assets/*\"}]}"
          }
        },
        {
          "address": "aws_db_instance.main",
          "mode": "managed",
          "type": "aws_db_instance",
          "name": "main",
          "values": {
            "identifier": "acme-main",
            "engine": "postgres",
            "instance_class": "db.t3.medium",
            "publicly_accessible": false,
            "storage_encrypted": true,
            "backup_retention_period": 14,
            "deletion_protection": true
          }
        },
        {
          "address": "aws_ebs_volume.data",
          "mode": "managed",
          "type": "aws_ebs_volume",
          "name": "data",
          "values": {
            "size": 100,
            "encrypted": true,
            "availability_zone": "eu-west-1a"
          }
        },
        {
          "address": "aws_cloudtrail.main",
          "mode": "managed",
          "type": "aws_cloudtrail",
          "name": "main",
          "values": {
            "name": "acme",
            "enable_logging": true,
            "is_multi_region_trail": true
          }
        },
        {
          "address": "aws_kms_key.main",
          "mode": "managed",
          "type": "aws_kms_key",
          "name": "main",
          "values": {
            "description": "acme",
            "enable_key_rotation": true
