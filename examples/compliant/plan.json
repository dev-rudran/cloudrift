            "protocol": "HTTPS"
          }
        },
        {
          "address": "aws_lambda_function.api",
          "mode": "managed",
          "type": "aws_lambda_function",
          "name": "api",
          "values": {
            "function_name": "api",
            "runtime": "python3.12",
            "handler": "app.handler",
            "environment": [
              {
                "variables": {
                  "LOG_LEVEL": "info"
                }
              }
            ]
          }
        },
        {
          "address": "aws_vpc.main",
          "mode": "managed",
          "type": "aws_vpc",
          "name": "main",
          "values": {
            "cidr_block": "10.0.0.0/16",
