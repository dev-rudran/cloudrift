          "name": "alerts",
          "values": {
            "name": "alerts",
            "kms_master_key_id": "alias/aws/sns"
          }
        },
        {
          "address": "aws_ecr_repository.app",
          "mode": "managed",
          "type": "aws_ecr_repository",
          "name": "app",
          "values": {
            "name": "app",
            "image_scanning_configuration": [
              {
                "scan_on_push": true
              }
            ]
          }
        },
        {
          "address": "aws_secretsmanager_secret.db",
